{
  "name": "oqui-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio et application de contact d'OQUI — Antoine ANANI",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "framer-motion": "12.23.24",
    "next": "15.5.29",
    "nodemailer": "6.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.20",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  }
}
