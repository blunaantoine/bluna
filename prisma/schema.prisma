generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  client      String   @default("")
  category    String
  year        Int
  summary     String
  description String
  /// Listes stockées en JSON (SQLite n'a pas de type tableau)
  tags        String   @default("[]")
  stack       String   @default("[]")
  images      String   @default("[]")
  cover       String
  coverBg     String   @default("#151517")
  link        String   @default("")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  views       Int      @default(0)
  inquiries   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  name        String
  phone       String   @default("")
  email       String   @default("")
  company     String   @default("")
  services    String   @default("[]")
  budget      String   @default("")
  deadline    String   @default("")
  body        String
  projectSlug String?
  status      String   @default("nouveau") // nouveau | lu | repondu | archive
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// Client facturé. Son lien personnel (/espace/<token>) liste toutes ses factures.
model Client {
  id        String    @id @default(cuid())
  name      String
  company   String    @default("")
  phone     String    @default("")
  email     String    @default("")
  token     String    @unique
  createdAt DateTime  @default(now())
  invoices  Invoice[]
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  token       String    @unique
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  /// Lignes en JSON : [{ label, qty, unitPrice }]
  items       String    @default("[]")
  discount    Int       @default(0)
  /// Motif affiché sur la facture (ex. « Offre annuelle : 2 mois offerts »)
  discountLabel String  @default("")
  total       Int
  amountPaid  Int       @default(0)
  allowDeposit Boolean  @default(false)
  status      String    @default("envoyee") // brouillon | envoyee | partielle | payee | annulee
  notes       String    @default("")
  projectSlug String?
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@index([clientId, status])
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Int
  method        String    // fedapay | mobile | especes | virement
  status        String    @default("en_attente") // en_attente | valide | refuse | annule
  provider      String    @default("")
  transactionId String?   @unique
  reference     String    @default("")
  payerName     String    @default("")
  payerPhone    String    @default("")
  /// Capture d'écran du transfert (fichier privé, visible seulement dans l'admin)
  proof         String    @default("")
  /// Lecture automatique de la capture par l'IA (JSON) et verdict : conforme | a_verifier | suspect
  aiData        String    @default("")
  aiVerdict     String    @default("")
  /// Date et heure du transfert lues sur la capture
  paidOn        DateTime?
  /// Reçu par e-mail : adresse demandée au client, et date d'envoi (Resend)
  receiptEmail  String    @default("")
  receiptSentAt DateTime?
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?
}
