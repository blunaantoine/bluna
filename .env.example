# Copiez ce fichier en .env puis remplissez les valeurs.

# Base de données (SQLite par défaut : un simple fichier)
DATABASE_URL="file:./dev.db"

# Espace admin (/admin)
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
# Chaîne aléatoire longue, ex. : openssl rand -hex 32
SESSION_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire"

# Adresse publique du site (pour les liens dans les notifications)
SITE_URL="https://oquitogo.com"

# ── Notifications d'un nouveau message (toutes optionnelles) ──
# Telegram : notification instantanée sur le téléphone.
# 1. Parlez à @BotFather sur Telegram, créez un bot, copiez le token.
# 2. Envoyez un message à votre bot, puis ouvrez
#    https://api.telegram.org/bot<TOKEN>/getUpdates pour lire votre chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# E-mail (SMTP). Avec Gmail : créez un « mot de passe d'application ».
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="blunaantoine@gmail.com"
UPLOAD_DIR="./data/uploads"

# ── Paiement des factures (FedaPay : T-Money, Flooz, carte bancaire) ──
# Clé secrète : tableau de bord FedaPay > Paramètres > Clés API.
# Commencez avec la clé « sandbox » (sk_sandbox_...) pour tester, puis passez en « live ».
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"   # sandbox | live

# Sans clé FedaPay, la facture propose le paiement manuel par Mobile Money :
# le client envoie l'argent à ces numéros puis clique « J'ai payé ». Vous validez dans l'admin.
PAY_TMONEY_NUMBER="+228 71 99 81 55"
PAY_FLOOZ_NUMBER="+228 96 22 28 21"
